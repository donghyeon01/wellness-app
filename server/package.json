    "argon2": "^0.41.1",
    "csrf-csrf": "^3.0.8",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.18.0",
    "@prisma/client": "^5.19.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.16.5",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
